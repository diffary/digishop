# Shared with the FastAPI backend; the +asyncpg driver suffix (if present) is
# stripped by config/db_url.py. Omit entirely (or use sqlite://) to run against an
# in-memory sqlite database.
DATABASE_URL=postgresql://digishop:digishop@localhost:5433/digishop

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
